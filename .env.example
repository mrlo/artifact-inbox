# Bearer token for /mcp and /api/*. Generate with: openssl rand -hex 32
INBOX_API_TOKEN=CHANGE_ME
# Public URL of the instance (used in links returned to agents and in /install).
INBOX_BASE_URL=http://localhost:8000
# Optional: built-in login for the web UI (HTTP basic auth). Leave empty if a reverse proxy handles auth.
# /mcp and /api always use the bearer token; /healthz and /install stay public.
INBOX_UI_PASSWORD=
INBOX_UI_USER=admin
